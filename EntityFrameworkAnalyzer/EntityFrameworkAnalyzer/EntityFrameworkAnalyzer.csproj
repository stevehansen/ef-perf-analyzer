<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- Analyzer and code fixes ship in one assembly, so it references Workspaces on purpose -->
    <NoWarn>$(NoWarn);RS1038</NoWarn>

    <PackageId>EntityFrameworkPerformanceAnalyzer</PackageId>
    <Version>2.0.0</Version>
    <Title>EntityFramework Performance Analyzer</Title>
    <Authors>Steve Hansen</Authors>
    <Description>A diagnostic analyzer for common Entity Framework 6 and Entity Framework Core performance issues.</Description>
    <Copyright>Copyright 2015-2026 Steve Hansen</Copyright>
    <PackageTags>analyzer entityframework efcore ef roslyn</PackageTags>
    <PackageProjectUrl>https://github.com/stevehansen/ef-perf-analyzer</PackageProjectUrl>
    <RepositoryUrl>https://github.com/stevehansen/ef-perf-analyzer</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <DevelopmentDependency>true</DevelopmentDependency>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoPackageAnalysis>true</NoPackageAnalysis>
  </PropertyGroup>

  <ItemGroup>
    <!-- 3.11 is the Roslyn in VS 2019 16.11 and the .NET 5 SDK: the analyzer loads in those and every later host -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="3.11.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources.resx">
      <Generator>MSBuild:Compile</Generator>
      <StronglyTypedFileName>$(IntermediateOutputPath)Resources.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>EntityFrameworkAnalyzer</StronglyTypedNamespace>
      <StronglyTypedClassName>Resources</StronglyTypedClassName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <!-- install.ps1 adds the analyzer to packages.config projects, which ignore the analyzers folder -->
    <None Include="tools/*.ps1" Pack="true" PackagePath="tools" />
    <None Include="../../README.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

</Project>
