<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.CodeFix.Testing" Version="1.1.4" />
    <!-- Tests run the analyzer in a current compiler; the analyzer project itself pins the oldest supported one -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="MSTest" Version="4.5.2" />
    <!-- Lifts the vulnerable 9.0.6 that the testing library pulls in through NuGet.Packaging -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EntityFrameworkAnalyzer\EntityFrameworkAnalyzer.csproj" />
  </ItemGroup>

</Project>
